{
  "name": "etf-swing-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev --test-scheduled",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:integration",
    "deploy:prepare": "node scripts/prepare-deploy.mjs",
    "deploy": "node scripts/deploy.mjs",
    "secrets:upload": "node scripts/upload-secrets.mjs",
    "test:browser": "npm run build && node scripts/integration.mjs --browser",
    "probe:market": "node --experimental-strip-types scripts/probe-market.mjs",
    "study:prices": "node --experimental-strip-types scripts/study-price-rules.mjs",
    "study:calibration": "node --experimental-strip-types scripts/study-price-calibration.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.141.0"
  }
}
